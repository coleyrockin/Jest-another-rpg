{
  "name": "jest-another-rpg",
  "version": "1.1.1",
  "description": "CLI-first RPG engine with deterministic gameplay systems and save/load support",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "test": "jest --runInBand",
    "coverage": "jest --coverage --runInBand",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "check": "npm run lint && npm test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/coleyrockin/Jest-another-rpg.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/coleyrockin/Jest-another-rpg/issues"
  },
  "homepage": "https://github.com/coleyrockin/Jest-another-rpg#readme",
  "directories": {
    "lib": "lib"
  },
  "engines": {
    "node": ">=16"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "jest": "^28.1.3",
    "prettier": "^3.3.3"
  },
  "dependencies": {
    "inquirer": "^8.2.4"
  }
}
